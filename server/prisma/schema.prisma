generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id
  email           String        @unique
  name            String
  imageUrl        String?
  role            UserRole      @default(LEARNER)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  comments        Comment[]
  coursesAuthored Course[]      @relation("CourseInstructor")
  enrollments     Enrollment[]
  progress        Progress[]
  reviews         Review[]
  transactions    Transaction[]
}

model Course {
  id           Int           @id @default(autoincrement())
  slug         String        @unique
  title        String
  description  String?
  category     String
  image        String?
  price        Float         @default(0.0)
  level        CourseLevel   @default(Beginner)
  status       CourseStatus  @default(Draft)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  instructorId String
  instructor   User          @relation("CourseInstructor", fields: [instructorId], references: [id])
  enrollments  Enrollment[]
  reviews      Review[]
  sections     Section[]
  transactions Transaction[]
  progresses   Progress[]
}

model Section {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  order       Int
  courseId    Int
  lectures    Lecture[]
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lecture {
  id        Int         @id @default(autoincrement())
  slug      String      @unique
  title     String
  type      LectureType @default(Video)
  content   String?
  videoUrl  String?
  order     Int
  sectionId Int
  comments  Comment[]
  section   Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  userId    String
  lectureId Int
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     String
  courseId   Int
  enrolledAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Progress {
  id                    Int      @id @default(autoincrement())
  isCompleted           Boolean  @default(false)
  updatedAt             DateTime @updatedAt
  lastAccessedTimeStamp DateTime @updatedAt
  overallProgress       Float    @default(0.0)
  courseId              Int
  course                Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId                String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Transaction {
  id              Int      @id @default(autoincrement())
  transactionId   String   @unique
  amount          Float
  paymentProvider String   @default("stripe")
  createdAt       DateTime @default(now())
  userId          String
  courseId        Int
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  LEARNER
  INSTRUCTOR
  ADMIN
}

enum CourseLevel {
  Beginner
  Intermediate
  Advanced
}

enum CourseStatus {
  Draft
  Published
}

enum LectureType {
  Video
  Text
  Quiz
}
